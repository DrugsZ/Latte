{
  "name": "@latte-js/milk",
  "version": "0.1.0",
  "description": "React UI component library for Latte",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --watch",
    "clean": "rm -rf dist"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DrugsZ/Latte.git",
    "directory": "packages/milk"
  },
  "keywords": [
    "latte-js",
    "latte",
    "react",
    "ui",
    "components"
  ],
  "author": "FateLee",
  "license": "GPL-3.0-or-later",
  "homepage": "https://github.com/DrugsZ/Latte#readme",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@latte-js/espresso": "workspace:*",
    "@latte-js/syrup": "workspace:*",
    "clsx": "^2.0.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "@types/react": "^18.0.0"
  }
}