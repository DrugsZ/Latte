{
  "name": "@latte/espresso",
  "version": "0.1.0",
  "description": "High-performance data kernel based on SharedArrayBuffer and SoA",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
