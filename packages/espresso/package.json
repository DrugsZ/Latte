{
  "name": "@latte-js/espresso",
  "version": "0.1.0",
  "description": "High-performance data kernel based on SharedArrayBuffer and SoA",
  "main": "./src/index.js",
  "module": "./src/index.mjs",
  "types": "./src/index.ts",
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "test": "vitest",
    "clean": "rm -rf dist"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DrugsZ/Latte.git",
    "directory": "packages/espresso"
  },
  "keywords": [
    "latte-js",
    "latte",
    "data-kernel",
    "sharedarraybuffer",
    "soa",
    "performance"
  ],
  "author": "FateLee",
  "license": "GPL-3.0-or-later",
  "homepage": "https://github.com/DrugsZ/Latte#readme",
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.mjs",
        "require": "./dist/index.js"
      }
    }
  },
  "dependencies": {
    "@latte-js/bean": "workspace:*",
    "gl-matrix": "^3.4.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  }
}