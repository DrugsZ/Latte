{
  "name": "@latte-js/barista",
  "version": "0.1.0",
  "description": "Logic scheduling and calculation engine (Worker Host)",
  "main": "./src/index.ts",
  "module": "./src/index.mjs",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsup src/index.ts src/worker/index.ts --format cjs,esm --dts",
    "type-check": "tsc --noEmit",
    "dev": "tsup src/index.ts --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DrugsZ/Latte.git",
    "directory": "packages/barista"
  },
  "keywords": [
    "latte-js",
    "latte",
    "worker",
    "scheduling",
    "computation"
  ],
  "author": "FateLee",
  "license": "GPL-3.0-or-later",
  "homepage": "https://github.com/DrugsZ/Latte#readme",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./worker": "./src/worker/index.ts"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.mjs",
        "require": "./dist/index.js"
      },
      "./worker": {
        "types": "./dist/worker/index.d.ts",
        "import": "./dist/worker/index.mjs",
        "require": "./dist/worker/index.js"
      }
    }
  },
  "dependencies": {
    "@latte-js/bean": "workspace:*",
    "@latte-js/espresso": "workspace:*",
    "@latte-js/kit": "workspace:*",
    "rbush": "^4.0.1"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.0.18",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^4.0.18"
  }
}