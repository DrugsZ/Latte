{
  "name": "@latte-js/art",
  "version": "0.1.0",
  "description": "Canvas rendering engine and interaction detection",
  "main": "./src/index.ts",
  "module": "./src/index.mjs",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "type-check": "tsc --noEmit",
    "dev": "tsup src/index.ts --watch",
    "clean": "rm -rf dist"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DrugsZ/Latte.git",
    "directory": "packages/art"
  },
  "keywords": [
    "latte-js",
    "latte",
    "canvas",
    "rendering",
    "interaction",
    "graphics"
  ],
  "author": "FateLee",
  "license": "AGPL-3.0-or-later",
  "homepage": "https://github.com/DrugsZ/Latte#readme",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.mjs",
        "require": "./dist/index.js"
      }
    }
  },
  "dependencies": {
    "@latte-js/bean": "workspace:*",
    "@latte-js/espresso": "workspace:*",
    "eventemitter3": "^5.0.1",
    "gl-matrix": "^3.4.4",
    "rbush": "^4.0.1"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.3.0"
  }
}
