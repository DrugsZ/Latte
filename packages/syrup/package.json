{
  "name": "@latte-js/syrup",
  "version": "0.1.0",
  "description": "Extension infrastructure and DI system",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --watch",
    "clean": "rm -rf dist"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DrugsZ/Latte.git",
    "directory": "packages/syrup"
  },
  "keywords": [
    "latte-js",
    "latte",
    "dependency-injection",
    "di",
    "extension",
    "plugin"
  ],
  "author": "FateLee",
  "license": "GPL-3.0-or-later",
  "homepage": "https://github.com/DrugsZ/Latte#readme",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@latte-js/bean": "workspace:*",
    "mitt": "^3.0.0"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.3.0"
  }
}