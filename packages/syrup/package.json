{
  "name": "@latte-js/syrup",
  "version": "0.1.0",
  "description": "Extension infrastructure and DI system",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "type-check": "tsgo --noEmit",
    "lint": "eslint src/",
    "test": "vitest run --passWithNoTests",
    "dev": "tsup src/index.ts --watch",
    "clean": "rm -rf dist"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DrugsZ/Latte.git",
    "directory": "packages/syrup"
  },
  "keywords": [
    "latte-js",
    "latte",
    "dependency-injection",
    "di",
    "extension",
    "plugin"
  ],
  "author": "FateLee",
  "license": "MIT",
  "homepage": "https://github.com/DrugsZ/Latte#readme",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.mjs",
        "require": "./dist/index.js"
      }
    }
  },
  "dependencies": {
    "@latte-js/bean": "workspace:*",
    "@latte-js/kit": "workspace:*",
    "mitt": "^3.0.0"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
