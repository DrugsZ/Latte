{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "baseUrl": "./",
    "rootDir": "./src",
    "outDir": "./dist",
    "noEmit": false,
    "paths": {
      "Latte/*": ["./src/*"],
      "components/*": ["./src/workbench/components/*"],
      "workbench/*": ["./src/workbench/*"]
    }
  },
  "include": ["src", "src/typings"],
  "exclude": ["vite.config.js", "node_modules", "dist"]
}
