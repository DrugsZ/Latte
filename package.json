{
  "name": "latte",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "clean": "turbo run clean && rm -rf node_modules",
    "test": "turbo run test",
    "test:coverage": "turbo run test -- --coverage",
    "test:watch": "vitest watch",
    "test:ui": "vitest --ui",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:update": "playwright test --update-snapshots",
    "diff:check": "git diff --check",
    "licenses:check": "node scripts/check-licenses.mjs",
    "packages:check": "node scripts/check-package-exports.mjs",
    "security:check": "pnpm audit --audit-level=high",
    "release:check": "node scripts/release-gate.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "prepare": "husky",
    "version": "pnpm run build",
    "publish:packages": "pnpm --filter \"./packages/**\" publish --access public",
    "prepublishOnly": "pnpm run release:check && pnpm run build"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.0.0",
    "@typescript/native-preview": "7.0.0-dev.20260609.1",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-import-resolver-node": "^0.3.9",
    "eslint-plugin-import-x": "^4.17.1",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "jsdom": "^27.4.0",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "tsup": "^8.5.1",
    "turbo": "^2.10.7",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@10.26.0",
  "pnpm": {
    "overrides": {
      "brace-expansion@<2.0.0": "1.1.16",
      "brace-expansion@>=2.0.0 <5.0.9": "5.0.9",
      "ajv@>=8.0.0 <8.20.0": "8.20.0",
      "fast-uri@>=3.0.0 <3.1.5": "3.1.5",
      "js-yaml@>=4.0.0 <4.3.1": "4.3.1",
      "minimatch@<3.1.4": "3.1.4",
      "nanoid@<3.3.17": "3.3.17",
      "picomatch@>=4.0.0 <4.0.5": "4.0.5",
      "postcss@>=8.0.0 <8.5.25": "8.5.25",
      "rollup@>=4.0.0 <4.62.3": "4.62.3",
      "ws@>=8.0.0 <8.21.1": "8.21.1"
    }
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
